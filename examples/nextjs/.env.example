# The API key/secret used to MINT tokens. Must match the project the target agent trusts:
#   - local mock (mock-a2a): devkey / secret
#   - real staging agent (real-a2a): your STAGING project key/secret
LK_API_KEY=devkey
LK_API_SECRET=secret

NEXT_PUBLIC_LK_TOKEN_ENDPOINT=/api/livekit/token

# The server URL returned with the token. The text-mode baseUrl derives the project id from it.
#   - mock: anything (ws://localhost:7880 is fine)
#   - real: wss://<project>.staging.livekit.cloud
NEXT_PUBLIC_LK_SERVER_URL=wss://my-livekit-project.livekit.cloud

# ----- text mode (useSession mode=text) target selection -----
# By default the text-mode baseUrl points at the STAGING frontdesk example agent:
#   https://<project>.staging.livekit.cloud/agents/dentist/default/frontend
# Override the agent/endpoint/env if needed:
# NEXT_PUBLIC_LK_A2A_AGENT=dentist
# NEXT_PUBLIC_LK_A2A_ENDPOINT=frontend
# NEXT_PUBLIC_LK_A2A_ENV=staging
#
# To target the LOCAL MOCK instead, set this to the mock's base (overrides everything above):
# NEXT_PUBLIC_LK_TEXT_BASE_URL=http://localhost:8787/fare-desk
