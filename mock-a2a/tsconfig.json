{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "verbatimModuleSyntax": true,

    // The server runs straight off source via `node --experimental-strip-types`, so
    // relative imports carry a literal `.ts` extension and nothing is ever emitted.
    // `erasableSyntaxOnly` keeps us inside what type-stripping can handle: no `enum`,
    // no `namespace`, no parameter properties.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
